    {
      "id": 23,
      "type": "volkovlabs-echarts-panel",
      "title": "Fréquence cardiaque par heure — une année",
      "description": "Moyenne horaire en Europe/Paris ; les cases vides sont les heures sans échantillon.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Europe/Paris\")\nfrom(bucket: \"garmin\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"garmin_heart_rate\" and r._field == \"bpm\")\n  |> aggregateWindow(every: 1h, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with hour: date.hour(t: r._time), day: date.truncate(t: r._time, unit: 1d)}))\n  |> keep(columns: [\"_time\", \"_value\", \"hour\", \"day\"])",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": {
        "editorMode": "code",
        "getOption": "const frames = context.panel.data.series || [];\nconst frame = frames[0];\nconst fields = (frame && frame.fields) || [];\nconst col = (name) => { const f = fields.find((x) => x.name === name); return f ? f.values : []; };\nconst days = col(\"day\"), vals = col(\"_value\"), hours = col(\"hour\");\nif (!days.length) {\n  return { title: { text: \"Pas de données\", left: \"center\", top: \"middle\", textStyle: { color: context.grafana.theme.colors.text.secondary } } };\n}\nconst fmt = new Intl.DateTimeFormat(\"sv-SE\", { timeZone: \"Europe/Paris\", year: \"numeric\", month: \"2-digit\", day: \"2-digit\" });\nconst keyOf = (d) => fmt.format(new Date(d));\nconst range = (context.panel.data.request && context.panel.data.request.range) || null;\nconst startKey = range ? keyOf(range.from) : keyOf(days[0]);\nconst endKey = range ? keyOf(range.to) : keyOf(days[days.length - 1]);\nconst dateIndex = new Map();\nconst dates = [];\nconst start = new Date(startKey + \"T00:00:00Z\");\nconst end = new Date(endKey + \"T00:00:00Z\");\nfor (let cur = start; cur <= end; cur = new Date(cur.getTime() + 86400000)) {\n  const key = cur.toISOString().slice(0, 10);\n  dateIndex.set(key, dates.length);\n  dates.push(key);\n}\nconst points = [];\nfor (let i = 0; i < days.length; i++) {\n  const x = dateIndex.get(keyOf(days[i]));\n  if (x !== undefined) points.push([x, hours[i], vals[i]]);\n}\nconst sorted = vals.slice().sort((a, b) => a - b);\nconst pick = (q) => sorted[Math.min(sorted.length - 1, Math.max(0, Math.floor(q * (sorted.length - 1))))];\nconst min = Math.floor(pick(0.02)), max = Math.ceil(pick(0.98));\nreturn {\n  animation: false,\n  backgroundColor: \"transparent\",\n  grid: { left: 8, right: 16, top: 16, bottom: 56, containLabel: true },\n  tooltip: { position: \"top\", formatter: (p) => `${dates[p.value[0]]} ${String(p.value[1]).padStart(2, \"0\")}:00 — ${p.value[2].toFixed(0)} bpm` },\n  xAxis: { type: \"category\", data: dates, axisTick: { show: false }, splitArea: { show: false }, axisLabel: { interval: (i, v) => v.endsWith(\"-01\"), hideOverlap: true, showMaxLabel: true, fontSize: 10 } },\n  yAxis: { type: \"category\", data: Array.from({ length: 24 }, (_, i) => i), name: \"heure\", nameGap: 10, axisTick: { show: false }, splitArea: { show: false }, axisLabel: { showMinLabel: true, showMaxLabel: true, fontSize: 10, formatter: (v) => `${v}h` } },\n  visualMap: { min, max, calculable: true, orient: \"horizontal\", left: \"center\", bottom: 0, itemWidth: 12, itemHeight: 140, text: [\"élevé\", \"bas\"], textStyle: { color: context.grafana.theme.colors.text.secondary }, inRange: { color: [\"#1b0c41\", \"#4a0c6b\", \"#781c6d\", \"#a52c60\", \"#cf4446\", \"#ed6925\", \"#fb9b06\", \"#f7d13d\", \"#fcfdbf\"] } },\n  series: [{ name: \"bpm\", type: \"heatmap\", data: points, progressive: 4000, emphasis: { itemStyle: { borderColor: \"rgba(255,255,255,0.65)\", borderWidth: 1 } } }],\n};",
        "renderer": "canvas"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
