          "query": "from(bucket: \"garmin\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"garmin_sleep\" and (r._field == \"deep_seconds\" or r._field == \"light_seconds\" or r._field == \"rem_seconds\" or r._field == \"awake_seconds\")) |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> map(fn: (r) => ({_time: r._time, deep: (if exists r.deep_seconds then r.deep_seconds else 0.0) / 3600.0, light: (if exists r.light_seconds then r.light_seconds else 0.0) / 3600.0, rem: (if exists r.rem_seconds then r.rem_seconds else 0.0) / 3600.0, awake: (if exists r.awake_seconds then r.awake_seconds else 0.0) / 3600.0}))",
